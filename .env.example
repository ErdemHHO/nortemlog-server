# Application
NODE_ENV=development
PORT=3000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=northemlog
DB_PASSWORD=northemlog_secret
DB_NAME=northemlog_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT Authentication
JWT_ACCESS_SECRET=change_this_to_a_secure_access_secret_key_min_32_chars
JWT_REFRESH_SECRET=change_this_to_a_secure_refresh_secret_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
